<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Third-party packages a specific library needs. Uno.Sdk itself is pinned in global.json. -->
    <PackageVersion Include="WinUI.TableView" Version="1.5.0-preview2" />
    <!-- Public API baseline: every public symbol is listed in PublicAPI.*.txt, so a break is a visible diff. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
  </ItemGroup>
</Project>
