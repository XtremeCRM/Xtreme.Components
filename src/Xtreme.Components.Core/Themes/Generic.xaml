<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Xtreme.Components theme tokens: the keys every family reads, with defaults derived from
        the WinUI theme so a control looks right in a bare Uno app. Override any of them in your
        App.xaml AFTER merging this dictionary (a later definition wins).

        Merge it once (the family dictionaries merge it themselves, so merging a family's
        Themes/Generic.xaml is enough):

            <ResourceDictionary Source="ms-appx:///Xtreme.Components.Core/Themes/Generic.xaml" />

        High-contrast: a palette the app merges on demand defines XcHighContrast (any value) plus
        XcSurfaceBrush / XcSurfaceOutlineBrush; those keys are deliberately NOT defaulted here, so
        their presence means "a high-contrast palette is active" (see ComponentTheme).
    -->

    <!-- Type ramp -->
    <x:Double x:Key="XcFontSizeCaption">12</x:Double>
    <x:Double x:Key="XcFontSizeBody">14</x:Double>
    <x:Double x:Key="XcFontSizeTitle">16</x:Double>

    <!-- Field label above an input -->
    <Style x:Key="XcFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource XcFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Section header inside a list -->
    <Style x:Key="XcListSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource XcFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <!-- Selectable list rows: row height and padding only; selection colours stay with the platform default -->
    <Style x:Key="XcListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>
