<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <Description>Dock manager for Uno Platform: a center document with edge-docked panes, tab groups and side-by-side layers, drag with docking guides, pushpin auto-hide rails with slide-in flyouts, float to a real OS window and drag back to re-dock, and whole-layout persistence through IDockPersistence. Host behavior enters through interfaces the app implements.</Description>
    <PackageTags>uno;uno-platform;winui;docking;dock;tool-windows;layout;workspace;cross-platform;skia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xtreme.Components.Docking.Tests" />
    <!-- The gallery's selftest drives the drag pipeline through DockHost.SelfTest.cs. -->
    <InternalsVisibleTo Include="Xtreme.Components.Gallery" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Xtreme.Components.Core/Xtreme.Components.Core.csproj" />
  </ItemGroup>
</Project>
