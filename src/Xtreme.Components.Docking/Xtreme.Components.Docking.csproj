<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <Description>Dock manager for Uno Platform: a centre document with edge-docked panes, tab groups and side-by-side layers, drag with docking guides, pushpin auto-hide rails with slide-in flyouts, float to a real OS window and drag back to re-dock, and whole-layout persistence through IDockPersistence. Host behaviour enters through interfaces the app implements.</Description>
    <PackageTags>uno;uno-platform;winui;docking;dock;tool-windows;layout;workspace;cross-platform;skia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xtreme.Components.Docking.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Xtreme.Components.Core/Xtreme.Components.Core.csproj" />
  </ItemGroup>
</Project>
