<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <Description>Helpers for WinUI.TableView on Uno Platform: RowFlagDecorator frames a flagged row in a colored frame and pins a small caps tag to it, theme-aware and recycle-safe. Separate from Xtreme.Components.Primitives because it depends on WinUI.TableView (as Xtreme.WinUI.TableView, its Uno 7 build).</Description>
    <PackageTags>uno;uno-platform;winui;tableview;datagrid;row-flag;cross-platform;skia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Our Uno 7 build of WinUI.TableView (upstream ships Uno 6.5 only); becomes a package dependency on Xtreme.WinUI.TableView. -->
    <ProjectReference Include="../Xtreme.WinUI.TableView/Xtreme.WinUI.TableView.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Xtreme.Components.Core/Xtreme.Components.Core.csproj" />
  </ItemGroup>
</Project>
