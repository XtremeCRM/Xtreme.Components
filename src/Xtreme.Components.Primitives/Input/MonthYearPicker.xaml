<UserControl
    x:Class="Xtreme.Components.Primitives.MonthYearPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Xtreme.Components.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" MinHeight="35" MinWidth="150">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="2">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PART_Decrement"
                Grid.Column="0"
                Width="28"
                MinWidth="28"
                VerticalAlignment="Center"
                Content="&lt;"
                Click="OnDecrementClick"
                Padding="0,0,4,0"
                Background="Transparent"
                BorderThickness="0" />

            <Button x:Name="PART_Center"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnCenterClick">
                <Grid MinWidth="50" ColumnSpacing="5" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PART_MonthText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Text="Month"
                           Margin="0"
                           FontSize="{StaticResource XcFontSizeBody}"/>

                    <Border Grid.Column="1" Width="1" Margin="0"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    
                    <TextBlock x:Name="PART_YearText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="0"
                           Text="Year"
                           FontSize="{StaticResource XcFontSizeBody}" />
                </Grid>
                <Button.Flyout>
                    <DatePickerFlyout x:Name="PART_DatePickerFlyout" DayVisible="False" Closed="OnDatePickerFlyoutClosed" />
                </Button.Flyout>
            </Button>

            <Button x:Name="PART_Increment"
                Grid.Column="2"
                Width="28"
                MinWidth="28"
                VerticalAlignment="Center"
                Content="&gt;"
                Click="OnIncrementClick"
                Padding="4,0,0,0"
                Background="Transparent"
                BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>

</UserControl>
