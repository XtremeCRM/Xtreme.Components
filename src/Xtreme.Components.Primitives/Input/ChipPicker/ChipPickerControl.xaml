<UserControl
    x:Class="Xtreme.Components.Primitives.ChipPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Xtreme.Components.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    x:Name="Root">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="XcBoolToVisibilityConverter" />
        <local:ColorToBrushConverter x:Key="XcColorToBrushConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Button x:Name="DropdownButton"
                        HorizontalAlignment="Stretch"
                        Click="Open_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ProgressRing   Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ElementName=Root,
                                                     Path=IsBusy,
                                                     Converter={StaticResource XcBoolToVisibilityConverter}}"/>
                <TextBlock  Grid.Column="0"
                            Text="{Binding ElementName=Root,
                                           Path=Title,
                                           FallbackValue='Select items...'}"
                            Visibility="{Binding ElementName=Root,
                                                 Path=ShowTitle,
                                                 Converter={StaticResource XcBoolToVisibilityConverter}}"
                            FontSize="{StaticResource XcFontSizeBody}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            HorizontalTextAlignment="Left"  
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>
                <ItemsRepeater Grid.Column="1"
                               ItemsSource="{Binding ElementName=Root, Path=SelectedItems}"
                               Visibility="{Binding ElementName=Root,
                                                     Path=IsBusy,
                                                     Converter={StaticResource XcBoolToVisibilityConverter},
                                                     ConverterParameter=invert}">
                    <ItemsRepeater.Layout>
                        <FlowLayout
                            Orientation="Horizontal"
                            MinColumnSpacing="4" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="{Binding ElementName=Root, Path=CalculatedMaxChipWidth}"
                                    Background="{Binding BackgroundColor,
                                                 Converter={StaticResource XcColorToBrushConverter},
                                                 ConverterParameter=AccentFillColorDefaultBrush}"
                                    CornerRadius="5"
                                    Padding="6,4"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <!-- XU-517: NOT badge — a red circle-slash leading the name,
                                         so an excluded rule reads as "everything except this" at
                                         a glance. Collapsed for ordinary (include) chips, which
                                         is every chip in every picker that leaves AllowExclude
                                         off.

                                         DRAWN, not a FontIcon glyph: this app's icon font does
                                         not carry the Blocked glyph (it rendered blank), and
                                         icon-font coverage here is already a known sore point
                                         across heads. Primitives always render. -->
                                    <Grid Width="10" Height="10"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsExcluded,
                                                               Converter={StaticResource XcBoolToVisibilityConverter}}">
                                        <Ellipse Stroke="#FFE04A4A" StrokeThickness="1.5" />
                                        <Rectangle Fill="#FFE04A4A"
                                                   Width="9" Height="1.5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <RotateTransform Angle="-45" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                    <TextBlock  Text="{Binding PillText}"
                                                FontSize="10"
                                                Foreground="{Binding ForegroundColor,
                                                                     Converter={StaticResource XcColorToBrushConverter},
                                                                     ConverterParameter=TextOnAccentFillColorPrimaryBrush}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                HorizontalTextAlignment="Left"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Button>
    </Grid>
</UserControl>
