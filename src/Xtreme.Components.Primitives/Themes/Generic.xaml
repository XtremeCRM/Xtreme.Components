<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xc="using:Xtreme.Components.Primitives">

    <!-- Merge this dictionary once in App.xaml:
             <ResourceDictionary Source="ms-appx:///Xtreme.Components.Primitives/Themes/Generic.xaml" />
         It brings the Core tokens (XcFontSize*, XcFieldLabelStyle, ...) with it. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Xtreme.Components.Core/Themes/Generic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Package tokens, theme-keyed. Override any of them in App.xaml after the merge (inside the
         matching ThemeDictionaries entry for a per-theme value).
           XcExcludedBrush        the NOT (exclude) marks in ChipPickerControl / ChipPickerDialog
           XcChipBackgroundBrush  pill fill for a ChipItem with no BackgroundColor
           XcChipForegroundBrush  pill text for a ChipItem with no ForegroundColor -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="XcExcludedBrush" Color="#FFD13438" />
            <SolidColorBrush x:Key="XcChipBackgroundBrush" Color="#FFE1E1E1" />
            <SolidColorBrush x:Key="XcChipForegroundBrush" Color="#FF000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="XcExcludedBrush" Color="#FFFF6B6B" />
            <!-- The neutral gray pill reads on dark surfaces too, so dark keeps the light values. -->
            <SolidColorBrush x:Key="XcChipBackgroundBrush" Color="#FFE1E1E1" />
            <SolidColorBrush x:Key="XcChipForegroundBrush" Color="#FF000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="XcExcludedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="XcChipBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="XcChipForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Converters the default templates below use. Keyed under the library's own names so an
         app's converters of the same type never collide. -->
    <xc:MultiplyConverter x:Key="XcMultiplyConverter" />

    <!-- OverlayGlyphIcon default style: a Fluent glyph (or app-supplied vector) with a small
         accent badge glyph overlaid bottom-right. -->
    <Style TargetType="xc:OverlayGlyphIcon">
        <Setter Property="BackForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FrontBackground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="FrontForeground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="xc:OverlayGlyphIcon">
                    <Grid Width="{TemplateBinding Size}"
                          Height="{TemplateBinding Size}">

                        <!-- Back icon (Fluent glyph) -->
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="{TemplateBinding BackGlyph}"
                            FontSize="{TemplateBinding Size}"
                            Foreground="{TemplateBinding BackForeground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />

                        <!-- Back icon (vector) renders when BackGeometryKey resolves through
                             ComponentHost.ResolveGeometry. Themed by BackForeground. -->
                        <Path
                            Data="{TemplateBinding BackData}"
                            Fill="{TemplateBinding BackForeground}"
                            Stretch="Uniform"
                            Margin="1.5"
                            IsHitTestVisible="False" />

                        <!-- Front overlay (badge). Width/Height and the glyph's FontSize are set in
                             code from Size x FrontSizeRatio (OverlayGlyphIcon.ApplyBadgeSize). -->
                        <Border
                            x:Name="PART_Badge"
                            Background="{TemplateBinding FrontBackground}"
                            CornerRadius="999"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False">
                            <FontIcon
                                x:Name="PART_FrontGlyph"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontWeight="ExtraBlack"
                                Glyph="{TemplateBinding FrontGlyph}"
                                Foreground="{TemplateBinding FrontForeground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
