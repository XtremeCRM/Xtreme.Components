                                            <Path.RenderTransform>
                                                <RotateTransform Angle="270" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Viewbox>
                                </controls:ResizeGrip>
                            </Grid>
                        </Grid>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button x:Name="NextButton" Content="&#x203A;" Width="36" Click="OnNext" />
            <Button x:Name="TodayButton" Content="Today" Margin="12,0,0,0" Click="OnToday" />
        </StackPanel>

        <!-- View switcher + settings. -->
        <StackPanel x:Name="RightPanel"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <!-- Wide layout: a single-select segmented control (joined toggles on one track).
                 First segment clears its left divider; first/last round their outer corners.
                 Add a view = add one styled ToggleButton here — the dropdown below mirrors it. -->
            <Border x:Name="ViewSegmented"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel x:Name="ViewSegmentPanel" Orientation="Horizontal" Spacing="0">
                    <ToggleButton x:Name="DayToggle" Content="Day" Tag="Day" BorderThickness="0" CornerRadius="5,0,0,5" Style="{StaticResource ViewSegmentStyle}" Click="OnViewClick" />
                    <ToggleButton x:Name="WeekToggle" Content="Week" Tag="Week" Style="{StaticResource ViewSegmentStyle}" Click="OnViewClick" />
                    <ToggleButton x:Name="MonthToggle" Content="Month" Tag="Month" Style="{StaticResource ViewSegmentStyle}" Click="OnViewClick" />
                    <ToggleButton x:Name="AgendaToggle" Content="Agenda" Tag="Agenda" Style="{StaticResource ViewSegmentStyle}" Click="OnViewClick" />
                    <ToggleButton x:Name="PlannerToggle" Content="Planner" Tag="Planner" CornerRadius="0,5,5,0" Style="{StaticResource ViewSegmentStyle}" Click="OnViewClick" />
                </StackPanel>
            </Border>

            <!-- Narrow layout: the same single choice as a dropdown picker. Items are built in
                 code-behind from the segments above, so the two switchers never drift. -->
            <ComboBox x:Name="ViewCombo"
                      Visibility="Collapsed"
                      MinWidth="118"
                      VerticalAlignment="Center"
                      SelectionChanged="OnViewComboChanged" />

            <!-- Adornment toggle group: a button row when wide, an "Adornments" dropdown when narrow
                 (mirrors the view switcher's segmented/dropdown swap). Populated in code-behind from
                 SchedulerControl.ToolbarAdornments; both hidden when there are no adornments. -->
            <StackPanel x:Name="AdornmentGroupPanel"
                        Orientation="Horizontal"
                        Spacing="0"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed" />
            <DropDownButton x:Name="AdornmentDropdown"
                            Content="Adornments"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="AdornmentMenu" />
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Host-supplied custom buttons (e.g. "open the map"). Populated in code-behind from
                 SchedulerControl.ToolbarButtons; empty by default so the generic control shows nothing
                 here. Sits between the view switcher and the Settings gear. -->
            <StackPanel x:Name="CustomButtonPanel"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Stretch" />

            <!-- Overflow: revealed in code-behind when the toolbar is too narrow to fit everything;
                 the lowest-priority items (custom buttons, then Today) move into this menu. -->
            <Button x:Name="OverflowButton"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="More">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE700;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="OverflowMenu" />
                </Button.Flyout>
            </Button>

            <!-- Visible-tiles picker: which of the calendar's offered tiles the user shows. Hidden
                 until the host supplies options via SetTileOptions (calendars with no tiles show no
                 button). One ToggleMenuFlyoutItem per tile, built in code-behind. -->
            <Button x:Name="TilesButton"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Visible tiles">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71D;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="TileOptionsMenu" />
                </Button.Flyout>
            </Button>

            <Button x:Name="SettingsButton" ToolTipService.ToolTip="Settings">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="10" Width="260">
                            <TextBlock Text="Time scale" FontWeight="SemiBold" />
                            <ComboBox x:Name="MajorTickCombo"
                                      Header="Hour labels every"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnTickChanged">
                                <ComboBoxItem Content="30 minutes" Tag="30" />
                                <ComboBoxItem Content="1 hour" Tag="60" />
                                <ComboBoxItem Content="2 hours" Tag="120" />
                            </ComboBox>
                            <ComboBox x:Name="MinorTickCombo"
                                      Header="Snap / gridlines"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnTickChanged">
                                <ComboBoxItem Content="5 minutes" Tag="5" />
                                <ComboBoxItem Content="10 minutes" Tag="10" />
                                <ComboBoxItem Content="15 minutes" Tag="15" />
                                <ComboBoxItem Content="30 minutes" Tag="30" />
                            </ComboBox>
                            <Slider x:Name="ZoomSlider"
                                    Header="Density (row height)"
                                    Minimum="0.4"
                                    Maximum="1.6"
                                    StepFrequency="0.1"
                                    ValueChanged="OnZoomChanged" />
                            <Slider x:Name="ColumnWidthSlider"
                                    Header="Min column width"
                                    Minimum="30"
                                    Maximum="320"
                                    StepFrequency="10"
                                    ValueChanged="OnColumnWidthChanged" />
                            <Slider x:Name="CornerRadiusSlider"
                                    Header="Corner radius"
                                    Minimum="0"
                                    Maximum="16"
                                    StepFrequency="1"
                                    ValueChanged="OnCornerRadiusChanged" />

                            <TextBlock Text="Work hours" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="WorkStartCombo"
                                          Grid.Column="0"
                                          Header="Start"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnWorkHoursChanged">
                                    <ComboBoxItem Content="6 AM" Tag="360" />
                                    <ComboBoxItem Content="7 AM" Tag="420" />
                                    <ComboBoxItem Content="8 AM" Tag="480" />
                                    <ComboBoxItem Content="9 AM" Tag="540" />
                                    <ComboBoxItem Content="10 AM" Tag="600" />
                                </ComboBox>
                                <ComboBox x:Name="WorkEndCombo"
                                          Grid.Column="1"
                                          Header="End"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnWorkHoursChanged">
                                    <ComboBoxItem Content="3 PM" Tag="900" />
                                    <ComboBoxItem Content="4 PM" Tag="960" />
                                    <ComboBoxItem Content="5 PM" Tag="1020" />
                                    <ComboBoxItem Content="6 PM" Tag="1080" />
                                    <ComboBoxItem Content="7 PM" Tag="1140" />
                                    <ComboBoxItem Content="8 PM" Tag="1200" />
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="Week" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <ComboBox x:Name="FirstDayCombo"
                                      Header="First day of week"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnFirstDayChanged">
                                <ComboBoxItem Content="Sunday" Tag="0" />
                                <ComboBoxItem Content="Monday" Tag="1" />
                            </ComboBox>

                            <StackPanel x:Name="GroupingSection" Spacing="6">
                                <TextBlock Text="Grouping" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <RadioButton x:Name="GroupResDateRadio"
                                             Content="Resource / Date"
                                             GroupName="schSettingsGroup"
                                             Checked="OnGroupRadioChanged" />
                                <RadioButton x:Name="GroupDateResRadio"
                                             Content="Date / Resource"
                                             GroupName="schSettingsGroup"
                                             Checked="OnGroupRadioChanged" />
                                <ToggleSwitch x:Name="HideIdleSwitch"
                                              Header="Hide idle resources"
                                              Toggled="OnHideIdleToggled" />
                            </StackPanel>

                            <ToggleSwitch x:Name="ShowTilesSwitch"
                                          Header="Show tiles"
                                          IsOn="True"
                                          Toggled="OnShowTilesToggled" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
