<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <RootNamespace>Xtreme.Components.Scheduler</RootNamespace>
    <Description>Primitive-only Uno Platform scheduler: Day, Week, Month, Agenda and multi-resource Planner views; drag-to-move and resize, click-to-create, external drag-drop, per-resource IANA time zones, recurring-event indicators and templatable appointments. No WebView, no third-party license.</Description>
    <PackageTags>uno;uno-platform;winui;scheduler;calendar;planner;appointments;cross-platform;skia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The toolbar's range picker is the Primitives MultiMonthDateNavigator. -->
    <ProjectReference Include="../Xtreme.Components.Primitives/Xtreme.Components.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Headless unit tests reach the internal pure-logic helpers (tile placement, zoned copies). -->
    <InternalsVisibleTo Include="Xtreme.Components.Scheduler.Tests" />
  </ItemGroup>
</Project>
