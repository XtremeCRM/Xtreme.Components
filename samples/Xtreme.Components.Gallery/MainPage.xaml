<Page x:Class="Xtreme.Components.Gallery.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <NavigationView x:Name="Nav"
                  PaneDisplayMode="Left"
                  IsSettingsVisible="False"
                  IsBackButtonVisible="Collapsed"
                  OpenPaneLength="220"
                  SelectionChanged="Nav_SelectionChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Scheduler" Tag="scheduler" Icon="Calendar" />
      <NavigationViewItem Content="Docking" Tag="docking" Icon="DockLeft" />
      <NavigationViewItem Content="Cards" Tag="cards" Icon="ViewAll" />
      <NavigationViewItem Content="Primitives" Tag="primitives" Icon="Edit" />
      <NavigationViewItem Content="TableView" Tag="tableview" Icon="List" />
    </NavigationView.MenuItems>

    <NavigationView.PaneFooter>
      <StackPanel Margin="12,8" Spacing="4">
        <ToggleSwitch x:Name="DarkToggle" Header="Dark theme" Toggled="DarkToggle_Toggled" />
        <TextBlock x:Name="VersionText" Opacity="0.6" FontSize="{StaticResource XcFontSizeCaption}" />
      </StackPanel>
    </NavigationView.PaneFooter>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Margin="20,16,20,8" Spacing="2">
        <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock x:Name="PageBlurb" TextWrapping="Wrap" Opacity="0.75" />
      </StackPanel>
      <ContentPresenter x:Name="Host" Grid.Row="1" Margin="20,0,20,16" />
    </Grid>
  </NavigationView>
</Page>
